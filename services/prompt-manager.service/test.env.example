# Integration Test Environment Variables for Prompt Manager Service
# Copy this file to test.env and replace placeholder values with your actual test configuration

# Database Configuration (Chats DB)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_test_password_min_16_chars
DB_NAME=chats_db

# Pub/Sub Configuration (Emulator)
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJECT_ID=local-project
PUBSUB_TOPIC_ID=prompt-requests
PUBSUB_SUBSCRIPTION_ID=prompt-requests-sub

# Auth Service Configuration
AUTH_SERVICE_URL=http://localhost:8001

# LLM Service URLs (Mock Services)
GEMMA3_SERVICE_URL=http://localhost:8003
QWEN3_SERVICE_URL=http://localhost:8004
