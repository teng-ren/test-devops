# Test Environment Variables for Auth Service Integration Tests
# 
# SECURITY WARNING: DO NOT use these credentials in production or any non-isolated environment!
# These are example values for local integration testing only.
#
# IMPORTANT:
# - Copy this file to 'test.env' and replace placeholder values before running tests
# - NEVER commit real credentials to version control
# - Use a dedicated, isolated test database with no sensitive data
# - Ensure test database is not accessible from external networks
# - Rotate credentials regularly, even for test environments
#
# For CI/CD pipelines, set these as encrypted environment variables or secrets

DB_HOST=localhost
DB_PORT=5432
DB_USER=test_user_CHANGE_ME
DB_PASSWORD=CHANGE_ME_test_password_min_16_chars
DB_NAME=authdb_test
JWT_SECRET=CHANGE_ME_random_secret_min_32_chars_for_testing_only
AUTH_SERVICE_URL=http://localhost:8001
